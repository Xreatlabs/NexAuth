<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Embedded limbo/protocol server uses NetByteBuf and manual packet handling -->
    <Match>
        <Class name="~ua\.nanit\.limbo\..*"/>
    </Match>
    <!-- Paper encryption uses reflection intentionally -->
    <Match>
        <Class name="~.*EncryptionUtil"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Records and DTOs hold data by design -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
